# Local development. Copy to .env and run `php artisan key:generate` and
# `php artisan vault:generate-local-keys`. Never put real provider secrets here:
# provider credentials live only in the tenant secret vault.
APP_NAME="Marketing Automation"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
ADMIN_DOMAIN=admin.saas.localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=json
LOG_LEVEL=debug
LOG_DEPRECATIONS_CHANNEL=null

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=54329
DB_DATABASE=saas
DB_USERNAME=saas_app
DB_PASSWORD=local_app_password
DB_OWNER_USERNAME=saas_owner
DB_OWNER_PASSWORD=local_owner_password
DB_PLATFORM_USERNAME=saas_platform
DB_PLATFORM_PASSWORD=local_platform_password

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis
CACHE_STORE=redis

REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=63799

MAIL_MAILER=log

SANCTUM_EXPIRATION=720

# Secret vault. Generate with `php artisan vault:generate-local-keys`.
SECRET_VAULT_KEK_DRIVER=local
SECRET_VAULT_LOCAL_KEK_ID=local-v1
SECRET_VAULT_LOCAL_KEK=
SECRET_VAULT_LOCAL_PREVIOUS_KEKS=
SECRET_VAULT_FINGERPRINT_KEY=
AUDIT_HASH_KEY=

EGRESS_STATIC_IPS=

# E-mail delivery: off | test_only | live. SES keys go to the vault (email:connect-ses).
EMAIL_SENDING_MODE=off
# 32+ random bytes, base64: php -r "echo 'base64:'.base64_encode(random_bytes(32));"
EMAIL_UNSUBSCRIBE_KEY=
