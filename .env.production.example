# Production template for Laravel Cloud (PratikTools). Values marked SECRET
# live in Laravel Cloud Secrets, never in a file. The application refuses
# to boot when a safety rule is violated (App\Support\ProductionGuard).
# See docs/production/laravel-cloud.md.

APP_NAME=PratikTools
APP_ENV=production
APP_KEY=                                   # CLOUD SECRET (php artisan key:generate --show)
APP_DEBUG=false
APP_URL=https://app.example.com
ADMIN_DOMAIN=admin.example.com
APP_MAINTENANCE_DRIVER=cache
APP_MAINTENANCE_STORE=redis

LOG_CHANNEL=json_stderr                    # Cloud filesystem is ephemeral
LOG_LEVEL=info

# Runtime connection = the RLS-bound app role. These custom values override
# the administrator credential Laravel Cloud injects. DB_URL is ignored.
DB_CONNECTION=pgsql
DB_HOST=                                   # direct endpoint, NOT the "-pooler" host
DB_PORT=5432
DB_DATABASE=
DB_USERNAME=saas_app
DB_PASSWORD=                               # SECRET
DB_SSLMODE=require
DB_OWNER_USERNAME=saas_owner               # migrations only
DB_OWNER_PASSWORD=                         # SECRET
DB_PLATFORM_USERNAME=saas_platform         # Super Admin
DB_PLATFORM_PASSWORD=                      # SECRET

# Laravel Valkey (TLS). Either the injected REDIS_URL=rediss://... or
# REDIS_HOST / REDIS_PORT / REDIS_PASSWORD with REDIS_SCHEME=tls.
REDIS_CLIENT=predis
REDIS_SCHEME=tls
REDIS_PREFIX=pratiktools-production-
CACHE_STORE=redis
QUEUE_CONNECTION=redis
REDIS_QUEUE_RETRY_AFTER=960                # > longest job timeout (900)

SESSION_DRIVER=redis
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

SANCTUM_EXPIRATION=720

# Proxies: empty = trust only the immediate peer (the Cloud edge).
TRUSTED_PROXIES=

# Secret vault: platform KEK from a Laravel Cloud Secret (local is refused
# in production). Generate with `php artisan vault:generate-kek` on a trusted
# workstation; keep an offline escrow copy. See docs/production/secret-vault-rotation.md.
SECRET_VAULT_KEK_DRIVER=cloud_secret
SECRET_VAULT_KEK=                          # CLOUD SECRET only (never a custom env var)
# SECRET_VAULT_KEK_PREVIOUS=               # CLOUD SECRET, only during a KEK rotation
SECRET_VAULT_FINGERPRINT_KEY=              # CLOUD SECRET (32+ random bytes, base64)
AUDIT_HASH_KEY=                            # CLOUD SECRET (32+ random bytes, base64)
# Optional AWS KMS driver (not used by default; needs aws/aws-sdk-php):
# SECRET_VAULT_KEK_DRIVER=aws_kms SECRET_VAULT_AWS_KMS_KEY_ID= SECRET_VAULT_AWS_REGION=eu-central-1
# SECRET_VAULT_AWS_ACCESS_KEY_ID= SECRET_VAULT_AWS_SECRET_ACCESS_KEY=

# Health: set true after Scheduler + Horizon are enabled.
HEALTH_REQUIRE_HEARTBEAT=false

# Push (OneSignal): sending off until explicitly enabled; see docs/production/onesignal.md.
PUSH_SENDING_MODE=off
ONESIGNAL_SYNC_SCHEDULE_ENABLED=false

# Off until explicitly enabled.
COMMERCE_SYNC_SCHEDULE_ENABLED=false
CONSENT_SYNC_SCHEDULE_ENABLED=false
IYS_ALLOW_PRODUCTION=false                 # requires EGRESS_STATIC_IPS
EGRESS_STATIC_IPS=
TICIMAX_SOAP_TRACE=false
