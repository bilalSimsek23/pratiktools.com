# Production template. Values come from the deployment secret manager, never
# from a committed file. The application refuses to boot in production when
# APP_DEBUG is on, cookies are not secure, or the local KEK driver is used.
APP_NAME="Marketing Automation"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://app.example.com
ADMIN_DOMAIN=admin.example.com

LOG_CHANNEL=json
LOG_LEVEL=info

DB_CONNECTION=pgsql
DB_HOST=
DB_PORT=5432
DB_DATABASE=saas
DB_USERNAME=saas_app
DB_PASSWORD=
DB_OWNER_USERNAME=saas_owner
DB_OWNER_PASSWORD=
DB_PLATFORM_USERNAME=saas_platform
DB_PLATFORM_PASSWORD=
DB_SSLMODE=require

SESSION_DRIVER=redis
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

QUEUE_CONNECTION=redis
CACHE_STORE=redis
REDIS_CLIENT=predis
REDIS_HOST=
REDIS_PASSWORD=
REDIS_PORT=6379

SANCTUM_EXPIRATION=720

# A real KMS driver must be implemented and selected before production.
SECRET_VAULT_KEK_DRIVER=
SECRET_VAULT_FINGERPRINT_KEY=
AUDIT_HASH_KEY=

EGRESS_STATIC_IPS=
